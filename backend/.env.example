# KrishiMitra AI - Environment Variables

# App Config
PROJECT_NAME="KrishiMitra AI"
ENVIRONMENT="development"
DEBUG=True
SECRET_KEY="krishimitra-dev-secret-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Default: local SQLite database; set DATABASE_URL to PostgreSQL/Supabase for production)
DATABASE_URL="sqlite:///./krishimitra.db"

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# External Weather API (Optional: If left blank, real Open-Meteo public endpoints and agronomic weather data are used)
WEATHER_API_KEY=""

# AI / LLM Advisory Provider (Optional: Supported: 'gemini', 'openai', 'groq', or blank for verified rule-based mode)
LLM_PROVIDER=""
LLM_API_KEY=""

# Machine Learning Disease Inference Service (Optional: URL to trained model API; if blank, verified knowledge demo mode is enabled)
DISEASE_MODEL_API_URL=""
